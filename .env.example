# ── Server Configuration ──────────────────────────────
# Render/Railway will set PORT automatically. Default: 8000
PORT=8000

# ── Telegram Alerts (Optional) ────────────────────────
# For IoT CRITICAL alert notifications via Telegram bot.
# Follow IoT_SETUP.md to get these values.
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── CORS Origin (Optional) ────────────────────────────
# In production, restrict to your deployed URL for security.
# Leave empty or "*" for development. Example: https://my-app.onrender.com
# CORS_ORIGIN=*

# ── Admin Credentials ─────────────────────────────────
# Default credentials for the dashboard login page.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
